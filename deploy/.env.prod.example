# Copy to deploy/.env.prod on the server.
# Do not commit deploy/.env.prod.

POSTGRES_DB=capstone
POSTGRES_USER=deva_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Use empty value for same-origin /api through Nginx.
NEXT_PUBLIC_API_BASE=

# Backend overrides used by docker-compose.prod.yml.
# If Besu runs from blockchain/network/besu/docker-compose.yml on the host,
# keep this value as host.docker.internal.
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=http://host.docker.internal:8545
BLOCKCHAIN_CHAIN_ID=20260720
BLOCKCHAIN_CONTRACT_ADDRESS=CHANGE_ME_CONTRACT_ADDRESS
BLOCKCHAIN_ARTIFACT_PATH=blockchain/artifacts/EvidenceRegistryV3.json
BLOCKCHAIN_WRITER_PRIVATE_KEY=CHANGE_ME_WRITER_PRIVATE_KEY
BLOCKCHAIN_DEPLOYMENT_BLOCK=12
BLOCKCHAIN_CONFIRMATIONS=0
BLOCKCHAIN_REQUEST_TIMEOUT_SECONDS=30
BLOCKCHAIN_CONFIRMATION_TIMEOUT_SECONDS=120
BLOCKCHAIN_CONFIRMATION_POLL_INTERVAL_SECONDS=1
QBFT_BLOCK_PERIOD_SECONDS=5
BLOCKCHAIN_MAX_BLOCK_AGE_SECONDS=30
